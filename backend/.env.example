# Copy to .env and fill in. Variables marked REQUIRED have no default: the app refuses
# to start without them. Comments must be on their own line: docker compose's env_file
# parser does not strip inline comments.

# --- Runtime ---------------------------------------------------------------
# dev | test | prod (prod hides /docs)
ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# false = human-readable console logs
LOG_JSON=true
# silentctx-api only
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# --- Neo4j -------------------------------------------------------------------
# REQUIRED. In docker compose these three are set by docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=silentctx-local-dev
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT_S=5
# Backoff while Neo4j is down (seconds)
NEO4J_RETRY_INITIAL_S=1
NEO4J_RETRY_MAX_S=30

# --- LLMs (provider:model, resolved by init_chat_model) ----------------------
# A missing key doesn't stop the app; /readyz reports llm=degraded.
CHAT_MODEL=anthropic:claude-sonnet-5-5
FAST_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings (Featherless, OpenAI-compatible) -----------------------------
EMBEDDING_BASE_URL=https://api.featherless.ai/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Must match the vector indexes (migration V0001), or /readyz stays 503.
EMBEDDING_DIM=1024
# Featherless Basic plan limit
EMBEDDING_MAX_CONCURRENCY=2
FEATHERLESS_API_KEY=

# --- Data and state ----------------------------------------------------------
DATA_DIR=../mock_data
# LangGraph checkpoints (sqlite)
STATE_DIR=.state
# true = demo backfill (plan 001 §3.5); false = full backfill for the T1 eval
DEMO_PROFILE=true

# --- Slack (Socket Mode; required by the slackbot, optional for the API) -----
# Bot token, xoxb-...
SLACK_BOT_TOKEN=
# App-level token with connections:write, xapp-...
SLACK_APP_TOKEN=
# Comma-separated channel ids, e.g. C0123,C0456
SLACK_CAPTURE_CHANNELS=

# --- MCP ---------------------------------------------------------------------
# REQUIRED. JSON object agent_id -> bearer token (>= 16 chars, unique per agent).
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKENS={"ops-agent": "replace-with-a-long-random-token"}

# Copy to .env and fill in. Variables marked REQUIRED have no default: the app refuses
# to start without them. Comments must be on their own line: docker compose's env_file
# parser does not strip inline comments.

# --- Runtime ---------------------------------------------------------------
# dev | test | prod (prod hides /docs)
ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# false = human-readable console logs
LOG_JSON=true
# kaiku-api only
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
# kaiku-sim only
SIM_HOST=0.0.0.0
SIM_PORT=8100
# Host names allowed to call POST /api/ui/reset and the simulator's fault and action
# endpoints, comma-separated, on top of localhost and the compose service names.
ALLOWED_HOSTS=

# --- Neo4j -------------------------------------------------------------------
# REQUIRED. In docker compose these three are set by docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kaiku-local-dev
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT_S=5
# Backoff while Neo4j is down (seconds)
NEO4J_RETRY_INITIAL_S=1
NEO4J_RETRY_MAX_S=30

# --- LLMs (provider:model: featherless, anthropic, or openai) ----------------
# Featherless serves chat and embeddings with one key (FEATHERLESS_API_KEY below).
# Use models with tool calling (Kimi-K2, Qwen3). A missing key degrades /readyz.
CHAT_MODEL=featherless:moonshotai/Kimi-K2-Instruct-0905
FAST_MODEL=featherless:Qwen/Qwen3-4B-Instruct-2507
# Only needed if CHAT_MODEL / FAST_MODEL use those providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings (Featherless, OpenAI-compatible) -----------------------------
EMBEDDING_BASE_URL=https://api.featherless.ai/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Must match the vector indexes (migration V0001), or /readyz stays 503.
EMBEDDING_DIM=1024
# Featherless Basic plan limit (concurrent requests)
EMBEDDING_MAX_CONCURRENCY=2
# Texts per request, and per-request timeout in seconds
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_S=30
FEATHERLESS_API_KEY=

# --- Data and state ----------------------------------------------------------
DATA_DIR=../mock_data
# Elisa's example folder (teams_chat.json, email.txt) for `kaiku replay` and
# `kaiku backfill --profile full`. Unset = ../Elisa_SinceAI2026/ELISA_HIDDEN_KNOWLEDGE_EXAMPLE_2026.
# docker compose sets /data/elisa.
ELISA_DIR=
# LangGraph checkpoints (sqlite)
STATE_DIR=.state
# true = demo backfill (plan 001 §3.5); false = full backfill for the T1 eval
DEMO_PROFILE=true
# Network simulator (SIM-1): the api pulls live telemetry from it. Unset = history only.
# docker compose sets http://sim:8100.
SIM_URL=http://localhost:8100
# The web console, linked from the Slack App Home.
CONSOLE_URL=http://localhost:8080

# --- Slack (Socket Mode; required by the slackbot, optional for the API) -----
# Bot token, xoxb-...
SLACK_BOT_TOKEN=
# App-level token with connections:write, xapp-...
SLACK_APP_TOKEN=
# Comma-separated channel ids, e.g. C0123,C0456
SLACK_CAPTURE_CHANNELS=
# Channel id where network faults are posted with the agent's advice and outcome buttons.
# The bot always watches the network (SIM_URL); this only picks where it posts.
# Unset = the channel named #noc-alarms, else the first SLACK_CAPTURE_CHANNELS entry.
SLACK_ALARM_CHANNEL=
# Channel id where [Ask <expert>] posts an undocumented question (#noc-transport).
# Unset = the channel the question was asked in.
SLACK_GAP_CHANNEL=
# Seconds after [Run bounce (simulated)] before the counters are checked
BOUNCE_SETTLE_S=40
# Capture loop: how often the sweeper looks for threads to triage, and how long a quiet
# thread waits before it is triaged without a resolution signal ("Traffic is back", ✅).
CAPTURE_SWEEP_SECONDS=60
CAPTURE_IDLE_MINUTES=10
# Channel id for capture decisions that never go to work channels (ignored threads,
# email/backfill captures). Unset = a channel named #context-log, else the log only.
SLACK_CONTEXT_LOG_CHANNEL=
# Email capture (BE-2.2): a folder polled for .eml / .msg files, e.g. a forwarded recap.
# docker compose mounts ./email_drop here. Unset = no live email capture.
EMAIL_DROP_DIR=
EMAIL_POLL_SECONDS=10

# --- MCP ---------------------------------------------------------------------
# REQUIRED. JSON object agent_id -> bearer token (>= 16 chars, unique per agent).
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKENS={"ops-agent": "replace-with-a-long-random-token"}
# Our ops agent (in the slackbot) connects here with MCP_TOKENS[OPS_AGENT_ID].
# docker compose sets MCP_URL=http://api:8000/mcp for the slackbot.
MCP_URL=http://localhost:8000/mcp
OPS_AGENT_ID=ops-agent
OPS_AGENT_TIMEOUT_S=120

# --- Traces and the web console (UI-1) ----------------------------------------
# Arize Phoenix OTLP/HTTP endpoint. docker compose sets http://phoenix:6006/v1/traces.
# Unset = no tracing (the console still works, without trace links).
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=kaiku
# Where a browser opens Phoenix, for the console's trace links (compose: http://localhost:6006)
PHOENIX_PUBLIC_URL=
# `kaiku eval` output read by the console's scorecard (compose: /data/eval/results)
EVAL_RESULTS_DIR=../eval/results
# Seconds between the console's live-stream checks of the graph
UI_POLL_SECONDS=2

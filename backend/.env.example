# Copy to .env and fill in. Variables marked REQUIRED have no default: the app refuses
# to start without them.

# --- Runtime ---------------------------------------------------------------
ENV=dev                         # dev | test | prod (prod hides /docs)
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                   # false = human-readable console logs
API_HOST=0.0.0.0                # silentctx-api only
API_PORT=8000
API_RELOAD=false

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687 # REQUIRED (bolt:// or neo4j://, +s/+ssc allowed)
NEO4J_USER=neo4j                # REQUIRED
NEO4J_PASSWORD=change-me-please # REQUIRED
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT_S=5
NEO4J_RETRY_INITIAL_S=1         # backoff while Neo4j is down
NEO4J_RETRY_MAX_S=30

# --- LLMs (provider:model, resolved by init_chat_model) ----------------------
# A missing key doesn't stop the app; /readyz reports llm=degraded.
CHAT_MODEL=anthropic:claude-sonnet-5-5
FAST_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings (Featherless, OpenAI-compatible) -----------------------------
EMBEDDING_BASE_URL=https://api.featherless.ai/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024
EMBEDDING_MAX_CONCURRENCY=2     # Featherless Basic plan limit
FEATHERLESS_API_KEY=

# --- Data and state ----------------------------------------------------------
DATA_DIR=../mock_data           # mounted read-only in compose
STATE_DIR=.state                # LangGraph checkpoints (sqlite)
DEMO_PROFILE=true               # true = demo backfill (plan 001 §3.5); false = full backfill for the T1 eval

# --- Slack (Socket Mode; required by the slackbot, optional for the API) -----
SLACK_BOT_TOKEN=                # xoxb-...
SLACK_APP_TOKEN=                # xapp-... (connections:write)
SLACK_CAPTURE_CHANNELS=         # comma-separated channel ids, e.g. C0123,C0456

# --- MCP ---------------------------------------------------------------------
# REQUIRED. JSON object agent_id -> bearer token (>= 16 chars, unique per agent).
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKENS={"ops-agent": "replace-with-a-long-random-token"}

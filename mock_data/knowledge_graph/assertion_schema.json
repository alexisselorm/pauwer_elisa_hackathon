{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextAssertion",
  "type": "object",
  "required": [
    "assertion_id",
    "subject_entity_id",
    "topic",
    "statement",
    "valid_from",
    "valid_to",
    "source_type",
    "source_ref",
    "confidence",
    "status"
  ],
  "properties": {
    "assertion_id": {
      "type": "string"
    },
    "subject_entity_id": {
      "type": "string",
      "description": "bound graph entity (see entities.jsonl)"
    },
    "topic": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "null = still believed true"
    },
    "competing_versions": {
      "type": "array"
    },
    "source_type": {
      "enum": [
        "teams_message",
        "email",
        "pdf",
        "confluence",
        "xlsx",
        "jira",
        "itsm"
      ]
    },
    "source_ref": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "enum": [
        "believed_true",
        "superseded",
        "disputed",
        "expired",
        "unverified"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "when the knowledge was first written down (transaction time); may be later than valid_from (e.g. a lock changed before anyone emailed about it) or earlier (e.g. a change announced in advance)"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "description": "assertion this one replaced"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "set iff status=superseded; its valid_from == this valid_to"
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "symmetric"
    },
    "corroborates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "symmetric; same knowledge from another source"
    }
  },
  "x-temporal-rules": [
    "valid_from <= valid_to (when valid_to is set); valid_to is exclusive",
    "status=believed_true|disputed|unverified -> valid_to is null or after the snapshot (2026-11-07T00:00:00Z)",
    "status=superseded -> superseded_by is set and successor.valid_from == valid_to",
    "status=expired -> valid_to <= snapshot and no successor (a bounded window that ended)",
    "status=disputed -> contradicts is non-empty",
    "the subject entity exists (entities.jsonl) at valid_from"
  ]
}
